rules_version = '2';

// Design: anything that moves money or is a team-only decision (approving a
// verification, resolving a dispute, crediting a deposit, debiting a wallet
// to accept a deal, marking a payout/refund complete) is written ONLY by the
// server using the admin SDK (see api/_lib/firebaseAdmin.js), which bypasses
// these rules entirely — the server verifies the caller's real Firebase ID
// token (for a customer action) or the team passcode (for a team action)
// before writing. These rules only need to cover the safe, non-financial,
// self-service writes a signed-in user can make directly from the browser.
//
// Email (not uid) is the identity key throughout, matching how the rest of
// the app already keys everything — Firebase ID tokens carry a verified
// `email` claim we can check against.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myEmail() {
      return request.auth.token.email;
    }
    function isMe(email) {
      return signedIn() && myEmail() == email;
    }

    // Full profile — phone and payoutMethod (real bank/momo account details)
    // live here, so this is self-read-only, not broadly readable. Self can
    // update only the safe fields — status/warnings/banReason are team-only
    // and never listed here, so a client write touching them is rejected
    // outright. The team reads this collection through the admin SDK
    // instead (bypasses rules), same as everything else team-side.
    match /users/{email} {
      allow read: if isMe(email);
      allow create: if isMe(email);
      // username can only be set directly by the client on a first-ever
      // claim (resource.data.username == '' — see claimUsername). Renaming
      // an already-set username goes through api/customer.js's renameUsername instead,
      // since that's rate-limited and writes usernameHistory, which the
      // client can never touch here.
      // activeWarning (team-issued warning + optional cooldown, see
      // api/team.js's warn action) is deliberately absent from the allowed
      // fields below — the client can only move it via acknowledgeWarning/
      // completeCooldown in api/customer.js, never by writing it directly.
      // premiumUntil is likewise absent — only api/customer.js's
      // upgradePremium can set it, after verifying a real payment.
      // profileCard (the Trust Card's background/font choice) is harmless
      // on its own — it only ever renders styled if premiumUntil is
      // actually active, so it's fine to let the client set it directly.
      allow update: if isMe(email) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'username', 'phone', 'payoutMethod', 'avatarUrl', 'countryIso', 'profileCard']) &&
        (request.resource.data.username == resource.data.username || resource.data.username == '');
      allow delete: if false;
    }

    // Safe-to-expose subset of a profile, readable by anyone (signed in or
    // not) — powers the public /u/{username} page. Never contains phone,
    // payoutMethod, or the verification doc's images; those stay private on
    // users/{email} and verifications/{email}. `verified` and
    // `usernameHistory`/`completedDealsCount` are server-only (admin SDK,
    // see api/team.js's verifications resource, api/customer.js's
    // renameUsername, and api/customer.js's releaseDeal) — the client can
    // create its own doc (at signup) and keep `name`/`avatarUrl` current,
    // and set `username` exactly once on a first claim, same shape as the
    // users/{email} rule above.
    match /public_profiles/{email} {
      allow read: if true;
      allow create: if isMe(email) &&
        request.resource.data.keys().hasOnly(['email', 'name', 'username', 'usernameHistory', 'verified', 'memberSince', 'completedDealsCount', 'avatarUrl']) &&
        (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
        (!('usernameHistory' in request.resource.data) || request.resource.data.usernameHistory == []) &&
        (!('completedDealsCount' in request.resource.data) || request.resource.data.completedDealsCount == 0);
      allow update: if isMe(email) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'username', 'avatarUrl']) &&
        (request.resource.data.username == resource.data.username ||
         !('username' in resource.data) || resource.data.username == '');
      allow delete: if false;
    }

    // Public directory for username search — deliberately just {email, name},
    // never phone/payoutMethod/status. Doc ID is the username itself so a
    // prefix search can range-query on it directly. Read is open to anyone,
    // signed in or not — the live "is this taken" check on the signup form
    // runs before an account exists, so it can't require auth. Create-only
    // (no renames in v1) and only by the account claiming that username.
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.email == myEmail();
      allow update, delete: if false;
    }

    // A deal's lifecycle. The non-financial transitions (cancel/decline/
    // dispute) are direct client writes; creating (needs the live exchange
    // rate to price the fee), accepting (debits a wallet), and releasing/
    // resolving (credits a seller) all go through api/customer.js /
    // api/team.js on the server instead, which is why they're absent here.
    match /deals/{code} {
      allow read: if resource.data.inviteType == 'link' || isMe(resource.data.sellerEmail) || isMe(resource.data.buyerEmail);
      allow create: if false;
      allow update: if
        (isMe(resource.data.sellerEmail) &&
          resource.data.status in ['pending-acceptance', 'invited'] &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])) ||
        (isMe(resource.data.buyerEmail) &&
          resource.data.status == 'invited' &&
          request.resource.data.status == 'declined' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'declinedAt'])) ||
        (isMe(resource.data.buyerEmail) &&
          resource.data.status == 'paid' &&
          request.resource.data.status == 'disputed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disputeReason', 'disputedAt']));
      allow delete: if false;
    }

    // Identity verification. A user can submit/resubmit their own — always
    // landing back in 'pending' — but can never set their own status to
    // verified/declined; only the team route can do that.
    match /verifications/{email} {
      allow read: if isMe(email);
      allow write: if isMe(email) && request.resource.data.status == 'pending';
    }

    // Money. Never written by the client, ever — only read by the account
    // they belong to.
    match /wallet_entries/{id} {
      allow read: if isMe(resource.data.email);
      allow write: if false;
    }
    match /transactions/{id} {
      allow read: if isMe(resource.data.buyerEmail) || isMe(resource.data.sellerEmail);
      allow write: if false;
    }
    match /refund_requests/{id} {
      allow read: if isMe(resource.data.email);
      allow write: if false;
    }
    match /payout_requests/{id} {
      allow read: if isMe(resource.data.email);
      allow write: if false;
    }

    // A single counter, bumped once per browser session from the landing
    // page (see src/pages/Welcome.jsx) — team-only to read (admin SDK,
    // api/team.js), but writable by anyone including signed-out visitors,
    // since that's exactly who it's counting. Can only ever move forward by
    // exactly 1 per write, never be set to an arbitrary value or backwards.
    match /analytics/visits {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['total']) && request.resource.data.total == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total']) &&
        request.resource.data.total == resource.data.total + 1;
      allow delete: if false;
    }

    // Support chat. Doc ID is the customer's email. Every write — sending a
    // message (customer OR team), typing pings, join/close, marking read —
    // goes through api/customer.js / api/team.js instead of a direct client
    // write: unread counts and lastMessage* are denormalized onto the
    // thread doc for a cheap badge/list read, and keeping those in sync
    // with the messages subcollection is exactly the kind of multi-field
    // coordinated write that's simplest to just always do server-side,
    // same reasoning as wallet_entries/transactions elsewhere in this file.
    match /chat_threads/{id} {
      allow read: if isMe(id);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isMe(id);
        allow write: if false;
      }
    }
  }
}
